{
  "name": "@immugio/infinite-grid",
  "version": "0.0.4",
  "description": "Antialiased infinite grid for Three.js based on https://github.com/Fyrestar/THREE.InfiniteGridHelper",
  "author": "Jan Mikeska <janmikeska@gmail.com>",
  "license": "ISC",
  "keywords": [
    "threejs",
    "three",
    "infinite grid"
  ],
  "bugs": {
    "url": "https://github.com/Immugio/infinite-grid/issues"
  },
  "homepage": "https://github.com/Immugio/infinite-grid#readme",
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "types/index.d.ts",
  "auto-changelog": {
    "commitLimit": false,
    "template": "keepachangelog"
  },
  "scripts": {
    "test": "npx jest",
    "dev": "tsc -watch",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig-cjs.json",
    "clean": "rimraf types cjs esm",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "preversion": "npm run clean && npm run build && npm run test",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@types/jest": "^29.2.1",
    "@types/three": "^0.149.0",
    "auto-changelog": "^2.4.0",
    "jest": "^29.2.2",
    "jest-environment-jsdom": "^29.2.2",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.23.23",
    "typedoc-plugin-markdown": "^3.14.0",
    "typescript": "^4.9.5",
    "three": "^0.149.0"
  },
  "peerDependencies": {
    "three": ">=0.130.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Immugio/infinite-grid.git"
  }
}
